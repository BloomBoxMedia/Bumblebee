# Password for the single login.
APP_PASSWORD=change-me
# Random string of 32+ characters used to sign the session cookie: openssl rand -base64 32
SESSION_SECRET=
# Optional: secret for the calendar feed URL (/api/calendar?token=...): openssl rand -hex 24
CALENDAR_TOKEN=
# Optional: free REST API key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# Optional: where the SQLite database lives (default ./data/bumblebee.db)
# DATABASE_PATH=/var/lib/bumblebee/bumblebee.db
